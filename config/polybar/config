[colors]
background     = #1e1e2e
background-alt = #313244
foreground     = #cdd6f4
primary        = #89b4fa
secondary      = #f5c2e7
success        = #a6e3a1
warning        = #f9e2af
urgent         = #f38ba8
cyan           = #89dceb
inactive       = #6c7086
disabled       = #707880  

[bar/main]
monitor = eDP-1
width = 100%
height = 42
radius = 6
fixed-center = true
bottom = true
offset-y = -2

background = ${colors.background}
foreground = ${colors.foreground}

separator = |  
separator-foreground = ${colors.disabled}

padding-left = 1
padding-right = 1
module-margin = 1

font-0 = "Cascadia Code NF:size=13;2"
font-1 = "Symbols Nerd Font Mono:size=13;2"
font-2 = "HarmonyOS Sans SC:size=13;2"

modules-left = xworkspaces window
modules-right = sysload temperature network volume custom-mic backlight battery tray clock

enable-ipc = true
wm-restack = bspwm

[module/xworkspaces]
type = internal/xworkspaces
enable-click = true
enable-scroll = true
pin-workspaces = true
visible-logging = false

label-active = %name%
label-active-background = ${colors.background-alt}
label-active-foreground = ${colors.primary}
label-active-underline = ${colors.primary}
label-active-padding = 1

label-occupied = %name%
label-occupied-foreground = ${colors.secondary}
label-occupied-padding = 1

label-urgent = %name%
label-urgent-background = ${colors.urgent}
label-urgent-foreground = ${colors.background}
label-urgent-padding = 1

label-empty = 
label-empty-foreground = ${colors.inactive}
label-empty-padding = 1

[module/window]
type = internal/xwindow
label = %title%
label-maxlen = 40
label-foreground = ${colors.secondary}

[module/sysload]
type = custom/script
interval = 3
exec = awk '{printf " %.2f", $1}' /proc/loadavg
label = %output%
label-foreground = ${colors.warning}

[module/temperature]
type = internal/temperature
interval = 0.5
thermal-zone = 9
zone-type = x86_pkg_temp
hwmon-path = /sys/devices/platform/coretemp.0/hwmon/hwmon9/temp1_input
base-temperature = 20
warn-temperature = 60
format = <label>
label = 󰔏 %temperature-c%
label-warn = 󱃂 %temperature-c%
label-warn-foreground = ${colors.urgent}

[module/network]
type = internal/network
interface-type = wireless
accumulate-stats = true
unknown-as-up = true
label-connected = 󰖩 %signal%% · %local_ip%
label-connected-foreground = ${colors.cyan}
label-disconnected = 󰖩 DOWN
label-disconnected-foreground = ${colors.urgent}
format-wireless = <label-connected>
interval = 3

[module/volume]
type = custom/script
tail = true
exec = ~/.config/polybar/scripts/volume.sh
click-left = wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
scroll-up = wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
scroll-down = wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
label = %output%
label-foreground = ${colors.primary}

[module/custom-mic]
type = custom/script
tail = true
exec = ~/.config/polybar/scripts/mic.sh
click-left = wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
scroll-up = wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+
scroll-down = wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-
label = %output%
label-foreground = ${colors.secondary}

[module/backlight]
type = internal/backlight
enable-scroll = true
card = intel_backlight

format-prefix = "󰃠 "
format-prefix-foreground = ${colors.warning}
label = %percentage%%
label-foreground = ${colors.foreground}
scroll-up = brightnessctl set +5%
scroll-down = brightnessctl set 5%-

[module/battery]
type = internal/battery
battery = BAT0
adapter = ADP1
full-at = 99 
low-at = 15

label-charging = 󰂄 %percentage%%
label-charging-foreground = ${colors.success}
label-discharging = 󰁹 %percentage%%
label-discharging-foreground = ${colors.success}
label-full = 󰁹 Full
label-full-foreground = ${colors.success}
label-low = 󰁹 %percentage%%!
label-low-foreground = ${colors.urgent}

[module/tray]
type = internal/tray
tray-size = 16
tray-spacing = 4

[module/clock]
type = internal/date
interval = 1

label = "%date% "
label-foreground = ${colors.cyan}
date = %Y-%m-%d %H:%M:%S
time-alt = %H:%M:%S

[settings]
screenchange-reload = true
pseudo-transparency = true
